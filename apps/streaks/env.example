# Copy to /opt/apps/env/streaks.env on the EC2 host. Do not commit real values.
# Used at container runtime (and, for NEXT_PUBLIC_VAPID_PUBLIC_KEY, also as a
# GitHub Actions build-arg — that secret must exist in the GitHub repo too).

NODE_ENV=production
PORT=3000
AUTH_TRUST_HOST=true

# Canonical public URL, no trailing slash. Also add this origin plus
# /api/auth/callback/google in the Google Cloud OAuth client.
AUTH_URL=https://streaks.kapillohani.site
NEXTAUTH_URL=https://streaks.kapillohani.site

# openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL (the shared compose database name is `streaks`)
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/streaks?schema=public

# Google OAuth (NextAuth v5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push. Generate once: bunx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY and is inlined at
# image build time — set the same value as a GitHub Actions secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:kapillohani023@gmail.com

# Shared secret for GET /api/cron/reminders (Authorization: Bearer ...)
# openssl rand -hex 32
CRON_SECRET=

# Shared secret the T2A agent sends as header x-mcp-secret to /api/mcp
MCP_SERVER_SECRET=

# Streaks AI chat calls a Task-to-API agent. URL is the public agent endpoint:
#   https://t2a.kapillohani.site/api/agents/<agentId>
# Token is that agent's bearer token from the T2A UI.
T2A_API_URL=
T2A_API_BEARER_TOKEN=
