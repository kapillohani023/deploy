# Copy to /opt/apps/env/task-to-api.env on the EC2 host. Do not commit real values.

NODE_ENV=production
PORT=3000
AUTH_TRUST_HOST=true

# Canonical public URL, no trailing slash. Also add this origin plus
# /api/auth/callback/google in the Google Cloud OAuth client.
AUTH_URL=https://t2a.kapillohani.site
NEXTAUTH_URL=https://t2a.kapillohani.site

# openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL (the shared compose database name is `task_to_api`)
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/task_to_api?schema=public

# Google OAuth (NextAuth v5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API keys are entered per user in the app UI and stored in the
# database. No GEMINI_API_KEY environment variable is required.
